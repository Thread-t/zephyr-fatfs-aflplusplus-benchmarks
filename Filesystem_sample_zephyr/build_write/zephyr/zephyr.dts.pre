/ {
 cpus {
  cpu@0 {
   riscv,isa = "rv32gc";
  };

  cpu@1 {
   riscv,isa = "rv32gc";
  };

  cpu@2 {
   riscv,isa = "rv32gc";
  };

  cpu@3 {
   riscv,isa = "rv32gc";
  };

  cpu@4 {
   riscv,isa = "rv32gc";
  };

  cpu@5 {
   riscv,isa = "rv32gc";
  };

  cpu@6 {
   riscv,isa = "rv32gc";
  };

  cpu@7 {
   riscv,isa = "rv32gc";
  };
 };
};
# 7 "/home/cheri/CHERI-zephyr/boards/qemu/riscv32cheri/qemu_riscv32cheri_purecap.dts" 2

/ {
 chosen {
  zephyr,console = &uart0;
  zephyr,shell-uart = &uart0;
  zephyr,sram = &ram0;
 };
};

&uart0 {
 status = "okay";
};
