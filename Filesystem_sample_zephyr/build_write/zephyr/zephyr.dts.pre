# 1 "/home/cheri/CHERI-zephyr/samples/fatfs_fuzz_uart/fatfs_fstab.overlay" 1






/ {
 fstab {
  compatible = "zephyr,fstab";
  ffs1: ffs1 {
   compatible = "zephyr,fstab,fatfs";

   disk-access;
   mount-point = "/RAM:";
  };
 };

 ramdisk0 {
  compatible = "zephyr,ram-disk";
  disk-name = "RAM";
  sector-size = <512>;
  sector-count = <128>;
 };
};
